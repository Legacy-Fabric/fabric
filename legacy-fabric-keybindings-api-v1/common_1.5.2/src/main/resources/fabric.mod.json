{
  "schemaVersion": 1,
  "id": "legacy-fabric-keybinding-api-v1-common",
  "name": "Legacy Fabric Keybinding API (V1)",
  "version": "${version}",
  "environment": "client",
  "license": "Apache-2.0",
  "icon": "assets/legacy-fabric-api/icon.png",
  "contact": {
    "homepage": "https://legacyfabric.net/",
    "issues": "https://github.com/Legacy-Fabric/fabric/issues",
    "sources": "https://github.com/Legacy-Fabric/fabric"
  },
  "authors": [
    "Legacy Fabric",
    "FabricMC"
  ],
  "provides": [
    "legacy-fabric-keybinding-api-v1-common-versioned"
  ],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": "${loader_version}",
    "osl-keybinds": ">=0.3.0-"
  },
  "entrypoints": {
    "client-init": [
      "net.legacyfabric.fabric.impl.client.keybinding.KeyBindingRegistryImpl"
    ]
  },
  "mixins": [
    "legacy-fabric-keybinding-api-v1-common.mixins.json"
  ],
  "description": "Hooks that help adding keybindings",
  "custom": {
    "modmenu": {
      "badges": [ "library" ],
      "parent": "legacy-fabric-api"
    }
  }
}
